{% extends 'base.html' %}
{% load static %}

{% block title %}Order #{{ order.order_number }} - Coffee & Tea Shop{% endblock %}

{% block extra_css %}
<style>
  .order-detail-page {
    padding: 60px 20px;
    background: var(--bg);
    min-height: calc(100vh - 300px);
  }
  
  .order-container {
    max-width: 1000px;
    margin: 0 auto;
  }
  
  .back-link {
    display: inline-block;
    margin-bottom: 20px;
    color: var(--primary);
    text-decoration: none;
  }
  
  .order-header-card {
    background: white;
    border-radius: 16px;
    padding: 25px;
    margin-bottom: 30px;
    box-shadow: var(--shadow);
  }
  
  .order-status-badge {
    display: inline-block;
    padding: 5px 15px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
  }
  
  .status-pending { background: #ffc107; color: #000; }
  .status-confirmed { background: #17a2b8; color: white; }
  .status-processing { background: #fd7e14; color: white; }
  .status-shipped { background: #6f42c1; color: white; }
  .status-delivered { background: #28a745; color: white; }
  .status-cancelled { background: #dc3545; color: white; }
  
  .info-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-top: 20px;
  }
  
  .info-card {
    background: var(--bg);
    padding: 15px;
    border-radius: 12px;
  }
  
  .info-card h4 {
    margin-bottom: 10px;
    color: var(--primary);
  }
  
  .order-items-card {
    background: white;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: var(--shadow);
    margin-bottom: 30px;
  }
  
  .order-items-card h3 {
    padding: 20px;
    border-bottom: 1px solid var(--border);
  }
  
  .items-table {
    width: 100%;
    border-collapse: collapse;
  }
  
  .items-table th {
    text-align: left;
    padding: 15px 20px;
    background: var(--bg);
  }
  
  .items-table td {
    padding: 15px 20px;
    border-bottom: 1px solid var(--border);
  }
  
  .total-card {
    background: white;
    border-radius: 16px;
    padding: 25px;
    box-shadow: var(--shadow);
  }
  
  .total-row {
    display: flex;
    justify-content: space-between;
    padding: 10px 0;
  }
  
  .total-row.grand {
    border-top: 2px solid var(--border);
    margin-top: 10px;
    padding-top: 15px;
    font-weight: 700;
    font-size: 1.2rem;
    color: var(--primary);
  }
  
  @media (max-width: 768px) {
    .info-grid {
      grid-template-columns: 1fr;
    }
    
    .items-table thead {
      display: none;
    }
    
    .items-table tr {
      display: block;
      margin-bottom: 15px;
      border: 1px solid var(--border);
      border-radius: 12px;
    }
    
    .items-table td {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 15px;
    }
    
    .items-table td::before {
      content: attr(data-label);
      font-weight: 600;
      width: 120px;
    }
  }
</style>
{% endblock %}

{% block content %}
<section class="order-detail-page">
  <div class="order-container">
    <a href="{% url 'orders:order_history' %}" class="back-link">← Back to Orders</a>
    
    <div class="order-header-card">
      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap;">
        <div>
          <h2>Order #{{ order.order_number }}</h2>
          <p>Placed on {{ order.created_at|date:"F j, Y, g:i a" }}</p>
        </div>
        <span class="order-status-badge status-{{ order.status }}">
          {{ order.get_status_display }}
        </span>
      </div>
      
      <div class="info-grid">
        <div class="info-card">
          <h4><i class="fas fa-map-marker-alt"></i> Delivery Address</h4>
          <p><strong>{{ order.full_name }}</strong></p>
          <p>{{ order.address }}</p>
          <p>{{ order.city }}{% if order.postal_code %}, {{ order.postal_code }}{% endif %}</p>
          <p>📞 {{ order.phone }}</p>
          <p>📧 {{ order.email }}</p>
        </div>
        <div class="info-card">
          <h4><i class="fas fa-credit-card"></i> Payment Information</h4>
          <p><strong>Method:</strong> {{ order.get_payment_method_display }}</p>
          <p><strong>Status:</strong> 
            <span style="color: {% if order.payment_status == 'paid' %}#28a745{% else %}#dc3545{% endif %}">
              {{ order.get_payment_status_display|title }}
            </span>
          </p>
          {% if order.payment_id %}
            <p><strong>Transaction ID:</strong> {{ order.payment_id }}</p>
          {% endif %}
          {% if order.notes %}
            <p><strong>Notes:</strong> {{ order.notes }}</p>
          {% endif %}
        </div>
      </div>
    </div>
    
    <div class="order-items-card">
      <h3>Order Items</h3>
      <table class="items-table">
        <thead>
          <tr>
            <th>Product</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Total</th>
          </tr>
        </thead>
        <tbody>
          {% for item in order.items.all %}
          <tr>
            <td data-label="Product">
              <div style="display: flex; align-items: center; gap: 10px;">
                {% if item.product.image %}
                  <img src="{{ item.product.image.url }}" alt="{{ item.product_name }}" style="width: 50px; height: 50px; object-fit: cover; border-radius: 8px;">
                {% endif %}
                {{ item.product_name }}
              </div>
            </td>
            <td data-label="Price">रू {{ item.product_price|floatformat:2 }}</td>
            <td data-label="Quantity">{{ item.quantity }}</td>
            <td data-label="Total">रू {{ item.total|floatformat:2 }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    
    <div class="total-card">
      <div class="total-row">
        <span>Subtotal</span>
        <span>रू {{ order.total_amount|floatformat:2 }}</span>
      </div>
      <div class="total-row">
        <span>Delivery Fee</span>
        <span>रू {{ order.delivery_charge|floatformat:2 }}</span>
      </div>
      {% if order.discount > 0 %}
      <div class="total-row">
        <span>Discount</span>
        <span>- रू {{ order.discount|floatformat:2 }}</span>
      </div>
      {% endif %}
      <div class="total-row grand">
        <span>Grand Total</span>
        <span>रू {{ order.grand_total|floatformat:2 }}</span>
      </div>
    </div>
  </div>
</section>
{% endblock %}